# Copy this file to .env and adjust values as needed.
# All defaults here match the docker-compose.yml fallbacks and work out of the box.

# Postgres — shared by the control plane and Keycloak
POSTGRES_USER=feanor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feanor

# MinIO (S3-compatible object store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Keycloak client secrets (used by services that connect to Keycloak)
AIRFLOW_SA_CLIENT_ID=airflow-sa
AIRFLOW_SA_CLIENT_SECRET=changeme-airflow-sa

# Dispatcher service account (used by the API to inject credentials into worker containers)
FEANOR_DISPATCHER_CLIENT_ID=dispatcher
FEANOR_DISPATCHER_CLIENT_SECRET=changeme

# Airflow — generate AIRFLOW_FERNET_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW_SECRET_KEY=changeme-airflow-secret
AIRFLOW_ADMIN_PASSWORD=admin
