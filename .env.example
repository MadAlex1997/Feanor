# Copy this file to .env and adjust values as needed.
# All defaults here match the docker-compose.yml fallbacks and work out of the box.

# Postgres — shared by the control plane and Keycloak
POSTGRES_USER=feanor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=feanor

# MinIO (S3-compatible object store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Keycloak client secrets (used by services that connect to Keycloak)
AIRFLOW_SA_CLIENT_SECRET=changeme-airflow-sa
